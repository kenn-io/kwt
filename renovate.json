{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "addLabels": ["dependencies"],
  "extends": ["config:recommended", "schedule:weekly", "github>kenn-io/actions//renovate/release-age"],
  "timezone": "America/New_York",
  "enabledManagers": ["github-actions", "gomod"],
  "osvVulnerabilityAlerts": true,
  "prCreation": "not-pending",
  "constraints": {
    "ghActionsLock": "v0.3.0"
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "groupSlug": "go-dependencies",
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "matchPackageNames": ["github.com/google/go-github/**"],
      "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": ["Group kenn-io releases. The shared release-age preset lets them skip the wait and the weekly window."],
      "matchPackageNames": ["kenn-io/**", "github.com/kenn-io/**", "go.kenn.io/**", "@kenn-io/**"],
      "groupName": "kenn-io dependencies",
      "groupSlug": "kenn-io-dependencies"
    }
  ]
}
